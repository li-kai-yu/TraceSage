<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tracesage</groupId>
        <artifactId>tracesage</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tracesage-system</artifactId>
    <name>tracesage-system</name>
    <description>系统服务：认证授权(RBAC) + 链路采集/清洗/存储/查询</description>

    <dependencies>
        <!-- 项目内部模块 -->
        <dependency>
            <groupId>com.tracesage</groupId>
            <artifactId>tracesage-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tracesage</groupId>
            <artifactId>tracesage-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tracesage</groupId>
            <artifactId>tracesage-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tracesage</groupId>
            <artifactId>tracesage-common-data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tracesage</groupId>
            <artifactId>tracesage-common-mq</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tracesage</groupId>
            <artifactId>tracesage-common-es</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tracesage</groupId>
            <artifactId>tracesage-trace-sdk</artifactId>
        </dependency>

        <!-- Spring Cloud -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 对象转换：编译期生成转换器 -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
